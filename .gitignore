# Python cache and bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
.venv/
ENV/
.python-version

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Environment and secrets
.env
.env.local
.streamlit/secrets.toml

# Local datasets
data/*
!data/sample_reviews.csv
!data/.gitkeep


# Generated exports
exports/*
!exports/.gitkeep

# Generated evaluation reports
reports/*
!reports/.gitkeep

# Hugging Face and app caches
.cache/
cache/
hf_cache/
huggingface/
.huggingface/


# Fine-tuned model outputs and artifacts
# Ignore all trained model files/folders, but keep the empty placeholder.
models/*
!models/.gitkeep


# Logs and temporary files
*.log
streamlit-err.log
streamlit-out.log
*.tmp
temp/
tmp/
.streamlit/logs/

# macOS
.AppleDouble
.LSOverride
*.DS_Store
